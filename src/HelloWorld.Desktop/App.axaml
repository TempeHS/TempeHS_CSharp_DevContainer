<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HelloWorld.Desktop.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system theme. "Dark" or "Light" are the other options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
